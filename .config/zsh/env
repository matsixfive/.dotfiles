#!/usr/bin/env zsh

# This file contains all of the environment variable
# definitions for the system as well as some other setup

export WAYLAND_DISPLAY=

export PATH="$HOME/.local/bin:$PATH"

export DESKTOP_PC_IP="192.168.1.83"
export OLLAMA_HOST="http://${DESKTOP_PC_IP}:11434"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# rust
export PATH="$HOME/.cargo/bin:$PATH"

# mcfly (reverse search)
export MCFLY_KEY_SCHEME=vim
export MCFLY_RESULTS_SORT=LAST_RUN
export MCFLY_FUZZY=2

# rvm
export PATH="$HOME/.rvm/bin:$PATH"
[[ -s "/usr/share/rvm/src/rvm/scripts/rvm" ]] && source "/usr/share/rvm/src/rvm/scripts/rvm"

# ghc
export PATH="$HOME/.ghcup/bin:$PATH"

# emsdk
export EMSDK_QUIET=1
[ -s "$HOME/.emsdk/emsdk_env.sh" ] && source "$HOME/.emsdk/emsdk_env.sh"

# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# initialize opam
[[ ! -r "$HOME/.opam/opam-init/init.zsh" ]] || source "$HOME/.opam/opam-init/init.zsh" > /dev/null 2> /dev/null

# mise (for uni)
_load_mise_on_gemfile() {
  # If MISE_INITIALIZED is not set AND a Gemfile exists
  if [[ -z "$MISE_INITIALIZED" && -f "Gemfile" ]]; then
    eval "$(mise activate zsh)"
    export MISE_INITIALIZED=1
    
    # Optional: Remove the hook after it runs once to save CPU cycles
    add-zsh-hook -d chpwd _load_mise_on_gemfile
  fi
}

# Add to the zsh hook list
autoload -U add-zsh-hook
add-zsh-hook chpwd _load_mise_on_gemfile

# Run once on startup in case you start inside a Ruby project
_load_mise_on_gemfile
